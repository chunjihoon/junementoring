rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /consultations/{document} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.idea is string
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.idea.size() <= 5000;
      allow read, update, delete: if false;
    }

    match /reviews/{document} {
      allow read: if resource.data.published == true;
      allow create: if request.resource.data.keys().hasOnly([
                      'submissionId', 'displayName', 'course', 'before', 'helpful',
                      'change', 'recommend', 'consentToPublish', 'published',
                      'createdAt', 'source'
                    ])
                    && request.resource.data.submissionId == document
                    && request.resource.data.submissionId is string
                    && request.resource.data.submissionId.size() >= 20
                    && request.resource.data.submissionId.size() <= 80
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.course in ['diagnosis', 'web', 'ios', 'other']
                    && request.resource.data.before is string
                    && request.resource.data.before.size() > 0
                    && request.resource.data.before.size() <= 3000
                    && request.resource.data.helpful is string
                    && request.resource.data.helpful.size() > 0
                    && request.resource.data.helpful.size() <= 3000
                    && request.resource.data.change is string
                    && request.resource.data.change.size() > 0
                    && request.resource.data.change.size() <= 3000
                    && request.resource.data.recommend is string
                    && request.resource.data.recommend.size() > 0
                    && request.resource.data.recommend.size() <= 3000
                    && request.resource.data.consentToPublish == true
                    && request.resource.data.published == true
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.source == 'review-page';
      allow update, delete: if false;
    }
  }
}
